# Replace these sample values with your own infrastructure details.

[cassandra]
node1 ansible_host=10.0.11.10
node2 ansible_host=10.0.12.10
node3 ansible_host=10.0.12.11

[cassandra:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=/path/to/your/bastion-key
ansible_ssh_common_args='-o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o ProxyCommand="ssh -i /path/to/your/bastion-key -o IdentitiesOnly=yes -W %h:%p ubuntu@YOUR_BASTION_PUBLIC_IP"'
